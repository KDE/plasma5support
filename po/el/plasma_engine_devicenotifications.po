#: ksolidnotify.cpp:149
#, kde-format
msgid "Device Status"
msgstr "Κατάσταση συσκευών"

#: ksolidnotify.cpp:149
#, kde-format
msgid "A device can now be safely removed"
msgstr "Μια συσκευή μπορεί πλέον να αφαιρεθεί με ασφάλεια"

#: ksolidnotify.cpp:150
#, kde-format
msgid "This device can now be safely removed."
msgstr "Αυτή η συσκευή μπορεί τώρα να αφαιρεθεί με ασφάλεια."

#: ksolidnotify.cpp:157
#, kde-format
msgid "You are not authorized to mount this device."
msgstr "Δεν είστε εξουσιοδοτημένοι να τοποθετήσετε αυτή τη συσκευή."

#: ksolidnotify.cpp:160
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "You are not authorized to remove this device."
msgstr "Δεν είστε εξουσιοδοτημένοι να αφαιρέσετε αυτή τη συσκευή."

#: ksolidnotify.cpp:163
#, kde-format
msgid "You are not authorized to eject this disc."
msgstr "Δεν είστε εξουσιοδοτημένοι να εξάγετε αυτό το δίσκο."

#: ksolidnotify.cpp:170
#, kde-format
msgid "Could not mount this device as it is busy."
msgstr "Αδυναμία προσάρτησης αυτής της συσκευής γιατί είναι απασχολημένη."

#: ksolidnotify.cpp:200
#, kde-format
msgid "One or more files on this device are open within an application."
msgstr ""
"Ένα ή περισσότερα αρχεία σε αυτή τη συσκευή είναι ανοιχτά σε μια εφαρμογή."

#: ksolidnotify.cpp:202
#, kde-format
msgid "One or more files on this device are opened in application \"%2\"."
msgid_plural ""
"One or more files on this device are opened in following applications: %2."
msgstr[0] ""
"Ένα ή περισσότερα αρχεία σε αυτή τη συσκευή έχουν ανοίξει στην εφαρμογή «%2»."
msgstr[1] ""
"Ένα ή περισσότερα αρχεία σε αυτή τη συσκευή έχουν ανοίξει στις ακόλουθες "
"εφαρμογές: %2."

#: ksolidnotify.cpp:205
#, kde-format
msgctxt "separator in list of apps blocking device unmount"
msgid ", "
msgstr ", "

#: ksolidnotify.cpp:222
#, kde-format
msgid "Could not mount this device."
msgstr "Αδυναμία προσάρτησης αυτής της συσκευής."

#: ksolidnotify.cpp:225
#, kde-format
msgctxt "Remove is less technical for unmount"
msgid "Could not remove this device."
msgstr "Αδυναμία αφαίρεσης αυτής της συσκευής."

#: ksolidnotify.cpp:228
#, kde-format
msgid "Could not eject this disc."
msgstr "Αδυναμία εξαγωγής αυτού του δίσκου."
